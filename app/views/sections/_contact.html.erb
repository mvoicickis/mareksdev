<section id="contact" class="section-padding pb-28">
  <div class="relative mx-auto max-w-6xl">
    <div class="glow-orb right-10 top-10 h-56 w-56 bg-accent/15"></div>

    <div class="relative glass overflow-hidden rounded-[2rem] p-8 sm:p-12 reveal" data-reveal>
      <h2 class="section-title">Contact</h2>
      <p class="mt-3 max-w-xl text-slate-400">
        Open to junior Ruby on Rails roles and thoughtful collaborations.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="<%= site_link(:github) %>" class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="<%= site_link(:linkedin) %>" class="btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="<%= site_link(:email) %>" class="btn-primary">Email</a>
        <a href="<%= site_link(:cv) %>" class="btn-ghost">Download CV</a>
      </div>
    </div>
  </div>
</section>
