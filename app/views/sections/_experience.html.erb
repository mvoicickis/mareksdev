<section id="experience" class="section-padding">
  <div class="mx-auto max-w-6xl">
    <div class="reveal" data-reveal>
      <h2 class="section-title">Experience</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        Relevant experience that shaped how I communicate, lead, and ship.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <% experiences.each do |job| %>
        <article class="glass card-lift rounded-3xl p-6 sm:p-8 reveal" data-reveal>
          <h3 class="text-xl font-bold text-white"><%= job[:company] %></h3>
          <% if job[:role].present? %>
            <p class="mt-1 text-sm font-medium text-accent-soft"><%= job[:role] %></p>
          <% end %>
          <ul class="mt-5 space-y-2 text-sm leading-relaxed text-slate-300 sm:text-base">
            <% job[:highlights].each do |highlight| %>
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span><%= highlight %></span>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>
    </div>

    <div class="mt-10 reveal" data-reveal>
      <a href="<%= site_link(:cv) %>" class="btn-secondary" target="_blank" rel="noopener noreferrer">View Full CV</a>
    </div>
  </div>
</section>
