<section id="journey" class="section-padding">
  <div class="mx-auto max-w-6xl">
    <div class="reveal" data-reveal>
      <h2 class="section-title">My Journey</h2>
      <p class="mt-3 text-slate-400">From marine engineering to shipping Ruby on Rails products.</p>
    </div>

    <ol class="relative mt-12 space-y-0 border-l border-white/10 pl-8">
      <% journey_steps.each_with_index do |step, index| %>
        <li class="relative pb-10 last:pb-0 reveal" data-reveal>
          <span class="absolute -left-[2.4rem] top-1 flex h-5 w-5 items-center justify-center rounded-full border border-accent/40 bg-surface">
            <span class="h-2 w-2 rounded-full <%= index == journey_steps.length - 1 ? 'bg-accent' : 'bg-slate-400' %>"></span>
          </span>
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-accent-soft"><%= step[:period] %></p>
          <p class="mt-2 max-w-3xl text-base leading-relaxed text-slate-200 sm:text-lg"><%= step[:description] %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>
