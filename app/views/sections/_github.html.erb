<section id="github-stats" class="section-padding">
  <div class="mx-auto max-w-6xl">
    <div class="reveal" data-reveal>
      <h2 class="section-title">GitHub</h2>
      <p class="mt-3 text-slate-400">Activity overview — placeholders until live stats are connected.</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { label: "Contribution graph", value: "—" },
        { label: "Repositories", value: "—" },
        { label: "Languages", value: "—" },
        { label: "Commits", value: "—" }
      ].each do |stat| %>
        <div class="glass card-lift rounded-3xl p-6 text-center reveal" data-reveal>
          <p class="text-3xl font-bold text-white"><%= stat[:value] %></p>
          <p class="mt-2 text-sm text-slate-400"><%= stat[:label] %></p>
        </div>
      <% end %>
    </div>

    <div class="glass mt-6 overflow-hidden rounded-3xl p-6 reveal" data-reveal>
      <div class="flex h-28 items-end gap-1 opacity-50 sm:h-36" aria-hidden="true">
        <% heights = [40, 55, 30, 70, 45, 80, 35, 60, 50, 75, 25, 65, 55, 40, 85, 45, 30, 70, 50, 60, 35, 75, 55, 45] %>
        <% opacities = %w[bg-accent/20 bg-accent/30 bg-accent/40 bg-accent/50 bg-accent/60] %>
        <% heights.each_with_index do |height, index| %>
          <div class="w-full rounded-sm <%= opacities[index % opacities.length] %>" style="height: <%= height %>%"></div>
        <% end %>
      </div>
      <p class="mt-4 text-center text-xs text-slate-500">Contribution graph placeholder</p>
    </div>
  </div>
</section>
