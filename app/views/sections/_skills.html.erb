<section id="skills" class="section-padding">
  <div class="mx-auto max-w-6xl">
    <div class="reveal" data-reveal>
      <h2 class="section-title">Skills</h2>
      <p class="mt-3 text-slate-400">Tools I use to design, build, and ship SaaS products.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <% skill_groups.each do |group| %>
        <div class="glass card-lift rounded-3xl p-6 reveal" data-reveal>
          <h3 class="text-lg font-semibold text-white"><%= group[:title] %></h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            <% group[:items].each do |item| %>
              <li class="tech-chip"><%= item %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
