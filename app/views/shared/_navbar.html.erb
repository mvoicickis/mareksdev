<header
  class="fixed inset-x-0 top-0 z-50"
  data-controller="navbar"
  data-action="scroll@window->navbar#onScroll"
>
  <nav
    class="glass-strong mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-b-2xl border-t-0 px-4 py-3 transition duration-300 sm:px-6"
    data-navbar-target="bar"
    aria-label="Primary"
  >
    <a href="#home" class="text-sm font-bold tracking-tight text-white transition hover:text-accent-soft sm:text-base">
      <%= site_name %>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      <% nav_links.each do |link| %>
        <li>
          <a href="<%= link[:href] %>" class="rounded-full px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/5 hover:text-white">
            <%= link[:label] %>
          </a>
        </li>
      <% end %>
    </ul>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white md:hidden"
      data-action="navbar#toggle"
      data-navbar-target="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg data-navbar-target="openIcon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg data-navbar-target="closeIcon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="mx-auto hidden max-w-6xl px-4 pt-2 md:hidden"
    data-navbar-target="menu"
    hidden
  >
    <ul class="glass space-y-1 rounded-2xl p-3">
      <% nav_links.each do |link| %>
        <li>
          <a
            href="<%= link[:href] %>"
            class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white"
            data-action="navbar#close"
          >
            <%= link[:label] %>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
</header>
